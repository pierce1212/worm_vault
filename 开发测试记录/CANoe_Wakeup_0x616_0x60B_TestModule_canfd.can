void TraceAdvanceIndex()
{
  gTraceNextIndex++;

  if (gTraceNextIndex >= gTraceMsgCount)
  {
    gTraceNextIndex = 0;
    write("All %ld CAN FD trace messages have been sent once; restart from the first ID.", gTraceMsgCount);
  }
}

void SendWakeupMsg_616()
{
  message 0x616 msgWake;

  if ((gState != 1) || (gWakeSendEnabled == 0))
  {
    return;
  }

  msgWake.dlc = 8;
  msgWake.byte(0) = 0x00;
  msgWake.byte(1) = 0x00;
  msgWake.byte(2) = 0x1F;
  msgWake.byte(3) = 0x00;
  msgWake.byte(4) = 0x00;
  msgWake.byte(5) = 0x00;
  msgWake.byte(6) = 0x00;
  msgWake.byte(7) = 0x00;

  output(msgWake);

  if ((gRound <= 10) || ((gRound % 1000) == 0))
  {
    write("Round %ld: send wakeup message 0x616, count=%d", gRound, gSendCount + 1);
  }
}

void FinishRepeatTest()
{
  cancelTimer(tWakeSend);
  cancelTimer(tSleepMonitor);
  cancelTimer(tNextRound);
  cancelTimer(tCanFdObserve);

  gState = 0;
  gTestRunning = 0;
  gWakeSendEnabled = 0;

  write("Wakeup/sleep repeat finished. Wake success=%ld, wake fail=%ld, sleep success=%ld, sleep fail=%ld, CAN FD sent=%ld, CAN FD no-wake=%ld, CAN FD abnormal wake=%ld",
        gWakeSuccessCount, gWakeFailCount, gSleepSuccessCount, gSleepFailCount,
        gTraceSentCount, gCanFdNoWakeCount, gCanFdAbnormalWakeCount);
}

void StartNextRound()
{
  if ((gTotalCount > 0) && (gRound >= gTotalCount))
  {
    FinishRepeatTest();
    return;
  }

  gRound++;
  gState = 1;
  gWakeSendEnabled = 1;
  gSendCount = 0;

  if (gTotalCount > 0)
  {
    write("Round %ld/%ld: start wakeup, send 0x616 every %d ms, max %d frames",
          gRound, gTotalCount, gSendPeriodMs, gMaxSendCount);
  }
  else
  {
    write("Round %ld: start wakeup, send 0x616 every %d ms, max %d frames",
          gRound, gSendPeriodMs, gMaxSendCount);
  }

  setTimer(tWakeSend, 1);
}

void StartSleepDisappearWait()
{
  cancelTimer(tWakeSend);
  cancelTimer(tNextRound);
  cancelTimer(tCanFdObserve);
  gWakeSendEnabled = 0;

  gState = 2;
  write("Round %ld: wait for 0x60B disappear after 0x616 wake, silent=%ld ms, timeout=%ld ms",
        gRound, gSleepSilentTimeMs, gSleepTimeoutMs);

  gSleepSilentElapsedMs = 0;
  gSleepWaitElapsedMs = 0;
  setTimer(tSleepMonitor, gSleepCheckPeriodMs);
}

void StartCanFdProbeDelay()
{
  cancelTimer(tWakeSend);
  cancelTimer(tSleepMonitor);
  cancelTimer(tCanFdObserve);
  gWakeSendEnabled = 0;
  gState = 3;

  write("Round %ld: sleep detected, wait %ld ms before CAN FD probe index %ld/%ld",
        gRound, gNextRoundDelayMs, gTraceNextIndex + 1, gTraceMsgCount);

  setTimer(tNextRound, gNextRoundDelayMs);
}

void SendTraceCanFdProbe()
{
  long indexToSend;

  if (gTraceMsgCount <= 0)
  {
    write("No CAN FD trace messages configured; stop test.");
    FinishRepeatTest();
    return;
  }

  indexToSend = gTraceNextIndex;
  TraceLoadCurrentMessage(indexToSend);

  if (gTraceCurrentIndex < 0)
  {
    write("Invalid CAN FD trace message index %ld; stop test.", indexToSend);
    FinishRepeatTest();
    return;
  }

  gState = 4;
  gCanErrorFrameCountAtProbe = gCanErrorFrameCount;
  setTimer(tCanFdObserve, gCanFdObserveTimeMs);
  output(gTraceCanFdMsg);
  gTraceSentCount++;

  write("Round %ld: send CAN FD probe %ld/%ld, ID=0x%X, length=%d, observe 0x60B for %ld ms",
        gRound, gTraceCurrentIndex + 1, gTraceMsgCount, gTraceCurrentId, gTraceCurrentLength, gCanFdObserveTimeMs);

  TraceAdvanceIndex();
}

void InitializeRepeatTest()
{
  cancelTimer(tWakeSend);
  cancelTimer(tSleepMonitor);
  cancelTimer(tNextRound);
  cancelTimer(tCanFdObserve);

  gState = 0;
  gTestRunning = 1;
  gWakeSendEnabled = 0;
  gRound = 0;
  gWakeSuccessCount = 0;
  gWakeFailCount = 0;
  gSleepSuccessCount = 0;
  gSleepFailCount = 0;
  gSendCount = 0;
  gSleepSilentElapsedMs = 0;
  gSleepWaitElapsedMs = 0;
  gTraceNextIndex = 0;
  gTraceCurrentIndex = -1;
  gTraceCurrentId = 0;
  gTraceCurrentLength = 0;
  gTraceSentCount = 0;
  gCanFdNoWakeCount = 0;
  gCanFdAbnormalWakeCount = 0;
  gCanErrorFrameCount = 0;
  gCanErrorFrameCountAtProbe = 0;

  if (gTotalCount > 0)
  {
    write("Start automatic wakeup/sleep CAN FD probe test, total rounds=%ld, trace messages=%ld.",
          gTotalCount, gTraceMsgCount);
  }
  else
  {
    write("Start automatic wakeup/sleep CAN FD probe test, run forever, trace messages=%ld.",
          gTraceMsgCount);
  }

  StartNextRound();
}

on start
{
  InitializeRepeatTest();
}

on stopMeasurement
{
  cancelTimer(tWakeSend);
  cancelTimer(tSleepMonitor);
  cancelTimer(tNextRound);
  cancelTimer(tCanFdObserve);
  gState = 0;
  gTestRunning = 0;
  gWakeSendEnabled = 0;

  write("Measurement stopped. Wake success=%ld, wake fail=%ld, sleep success=%ld, sleep fail=%ld, CAN FD sent=%ld, CAN FD no-wake=%ld, CAN FD abnormal wake=%ld, next trace index=%ld/%ld",
        gWakeSuccessCount, gWakeFailCount, gSleepSuccessCount, gSleepFailCount,
        gTraceSentCount, gCanFdNoWakeCount, gCanFdAbnormalWakeCount,
        gTraceNextIndex + 1, gTraceMsgCount);
}

on timer tWakeSend
{
  if ((gState != 1) || (gWakeSendEnabled == 0))
  {
    return;
  }

  if (gSendCount < gMaxSendCount)
  {
    SendWakeupMsg_616();
    gSendCount++;
    setTimer(tWakeSend, gSendPeriodMs);
    return;
  }

  gWakeFailCount++;
  gWakeSendEnabled = 0;
  cancelTimer(tWakeSend);

  write("Round %ld wakeup failed: 0x60B not received after %d transmissions of 0x616. Last CAN FD probe index=%ld/%ld, ID=0x%X, errorFrames=%ld. Stop script immediately.",
        gRound, gMaxSendCount, gTraceCurrentIndex + 1, gTraceMsgCount, gTraceCurrentId, gCanErrorFrameCount);

  FinishRepeatTest();
}

on timer tSleepMonitor
{
  if (gState != 2)
  {
    return;
  }

  gSleepSilentElapsedMs = gSleepSilentElapsedMs + gSleepCheckPeriodMs;
  gSleepWaitElapsedMs = gSleepWaitElapsedMs + gSleepCheckPeriodMs;

  if (gSleepSilentElapsedMs >= gSleepSilentTimeMs)
  {
    gSleepSuccessCount++;
    write("Round %ld sleep success after 0x616 wake: 0x60B disappeared for %ld ms",
          gRound, gSleepSilentTimeMs);

    StartCanFdProbeDelay();
    return;
  }

  if (gSleepWaitElapsedMs >= gSleepTimeoutMs)
  {
    gSleepFailCount++;
    write("Round %ld failed: 0x60B did not disappear within %ld ms, stop sequence",
          gRound, gSleepTimeoutMs);

    FinishRepeatTest();
    return;
  }

  setTimer(tSleepMonitor, gSleepCheckPeriodMs);
}

on timer tNextRound
{
  if (gState == 3)
  {
    write("Round %ld: delay finished, send CAN FD probe", gRound);
    SendTraceCanFdProbe();
    return;
  }

  if (gState == 6)
  {
    write("Round %ld: delay finished, start next 0x616 wakeup", gRound);
    gState = 0;
    StartNextRound();
    return;
  }
}

on timer tCanFdObserve
{
  if (gState != 4)
  {
    return;
  }

  gCanFdNoWakeCount++;
  write("Round %ld CAN FD probe no abnormal wake: ID=0x%X, CAN FD abnormal wake count=%ld, no-wake count=%ld, errorFramesDuringProbe=%ld",
        gRound, gTraceCurrentId, gCanFdAbnormalWakeCount, gCanFdNoWakeCount,
        gCanErrorFrameCount - gCanErrorFrameCountAtProbe);

  write("Round %ld: no 0x60B response within %ld ms after CAN FD probe, send normal CAN 0x616 next",
        gRound, gCanFdObserveTimeMs);

  gState = 0;
  StartNextRound();
}

on message 0x60B
{
  if (gState == 1)
  {
    cancelTimer(tWakeSend);
    gWakeSendEnabled = 0;
    gWakeSuccessCount++;

    write("Round %ld wakeup success: detected 0x60B, stop sending 0x616",
          gRound);

    StartSleepDisappearWait();
    return;
  }

  if (gState == 4)
  {
    cancelTimer(tCanFdObserve);
    gCanFdAbnormalWakeCount++;

    write("Round %ld CAN FD abnormal wake detected: ID=0x%X, length=%d, CAN FD abnormal wake count=%ld. Stop script immediately.",
          gRound, gTraceCurrentId, gTraceCurrentLength, gCanFdAbnormalWakeCount);

    FinishRepeatTest();
    return;
  }

  if (gState == 2)
  {
    gSleepSilentElapsedMs = 0;
  }
}

on errorFrame
{
  gCanErrorFrameCount++;

  if ((gCanErrorFrameCount <= 20) || ((gCanErrorFrameCount % 100) == 0))
  {
    write("CAN error frame detected, count=%ld, state=%d, last CAN FD ID=0x%X",
          gCanErrorFrameCount, gState, gTraceCurrentId);
  }
}
