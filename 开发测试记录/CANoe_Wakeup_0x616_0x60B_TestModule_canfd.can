includes
{
}

variables
{
  msTimer tWakeSend;
  msTimer tSleepMonitor;
  msTimer tNextRound;
  msTimer tCanFdObserve;

  message *gTraceCanFdMsg;

  int gState = 0;             // 0=idle, 1=sending 0x616, 2=waiting sleep after 0x616, 3=waiting CAN FD probe delay, 4=observing CAN FD probe, 6=waiting next 0x616
  int gTestRunning = 0;
  int gWakeSendEnabled = 0;
  long gRound = 0;
  long gTotalCount = 0;       // 0 means run forever
  long gWakeSuccessCount = 0;
  long gWakeFailCount = 0;
  long gSleepSuccessCount = 0;
  long gSleepFailCount = 0;

  int gSendCount = 0;
  int gMaxSendCount = 200;
  int gSendPeriodMs = 10;

  long gSleepSilentElapsedMs = 0;
  long gSleepWaitElapsedMs = 0;
  long gSleepSilentTimeMs = 500;   // 0x60B absent this long means sleep
  long gSleepTimeoutMs = 10000;    // stop sequence if 0x60B is still present after this
  long gSleepCheckPeriodMs = 100;
  long gNextRoundDelayMs = 10000;  // wait after sleep is detected

  long gTraceMsgCount = 162;
  long gTraceNextIndex = 0;
  long gTraceCurrentIndex = -1;
  long gTraceCurrentId = 0;
  int gTraceCurrentLength = 0;
  long gTraceSentCount = 0;
  long gCanFdNoWakeCount = 0;
  long gCanFdAbnormalWakeCount = 0;
  long gCanFdObserveTimeMs = 10000; // observe 0x60B this long after the CAN FD probe
  long gCanErrorFrameCount = 0;
  long gCanErrorFrameCountAtProbe = 0;
}

long GetCanFdDlcCode(long dataLength)
{
  if (dataLength <= 8) { return dataLength; }
  if (dataLength <= 12) { return 9; }
  if (dataLength <= 16) { return 10; }
  if (dataLength <= 20) { return 11; }
  if (dataLength <= 24) { return 12; }
  if (dataLength <= 32) { return 13; }
  if (dataLength <= 48) { return 14; }
  return 15;
}

void TraceClearCurrentMessage()
{
  long i;

  for (i = 0; i < 64; i++)
  {
    gTraceCanFdMsg.byte(i) = 0;
  }
}

